# =============================================================================
# Secure .npmrc -- copy this file into any project as .npmrc
# =============================================================================

# Block postinstall scripts (the #1 supply chain attack vector).
# If a package legitimately needs scripts (e.g., node-sass, esbuild),
# allow it explicitly:
#   npm install <package> --ignore-scripts=false
ignore-scripts=true

# Use the lockfile exactly. Prevents silent version drift.
package-lock=true

# Reject packages published less than 3 days ago (npm v11+).
# Remove or lower if you need bleeding-edge packages for a specific reason.
min-release-age=3

# Save exact versions (no ^ or ~ prefixes).
save-exact=true

# Always generate a lockfile.
# In CI, use "npm ci" instead of "npm install".
